{
  "name": "@falang/workflow-local",
  "version": "1.0.0",
  "description": "Local mode of the workflow product: PGlite database, disk file storage, process-backed runners (ADR 0072)",
  "license": "AGPL-3.0-only",
  "author": "",
  "type": "commonjs",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run -c ../../../vitest.config.ts",
    "coverage": "vitest run --coverage -c ../../../vitest.config.ts",
    "check": "tsc --noEmit -p tsconfig.build.json",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@falang/workflow-backend": "*",
    "@falang/workflow-media": "*",
    "@falang/workflow-runner": "*",
    "@nestjs/common": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "express": "^5.1.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "mysql-memory-server": "^1.18.0",
    "pg": "^8.22.0"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.e2e.test.ts",
    "!src/**/*.workflow-e2e-spec.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.docker-e2e-spec.ts",
    "!src/**/*-test-harness.ts",
    "!src/test-utils",
    "!src/**/__snapshots__",
    "!src/**/*.local-e2e-spec.ts"
  ]
}
