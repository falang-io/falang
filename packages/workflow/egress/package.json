{
  "name": "@falang/workflow-egress",
  "version": "1.0.0",
  "description": "Per-request egress routing for integration traffic (ADR 0056 (private)): an undici dispatcher that sends a vendor's outbound requests through a configured forward proxy, keyed by an AsyncLocalStorage vendor context.",
  "license": "AGPL-3.0-only",
  "author": "",
  "type": "commonjs",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run -c ../../../vitest.config.ts",
    "coverage": "vitest run --coverage -c ../../../vitest.config.ts",
    "check": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@types/node": "^25.5.0",
    "tslib": "^2.8.1",
    "undici": "^7.29.1"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.e2e.test.ts",
    "!src/**/*.workflow-e2e-spec.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.docker-e2e-spec.ts",
    "!src/**/*-test-harness.ts",
    "!src/test-utils",
    "!src/**/__snapshots__"
  ]
}
