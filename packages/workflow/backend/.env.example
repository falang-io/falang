# Copy to .env for local (non-docker) runs of `npm run start` / `npm run start:dev`.

PORT=4000

# Postgres connection for users/projects/folders/documents persistence.
DB_HOST=localhost
DB_PORT=5432
DB_USER=falang
DB_PASSWORD=falang
DB_NAME=falang_workflow

# Secret used to sign login JWTs — set a real value outside local dev.
JWT_SECRET=dev-secret-change-me
