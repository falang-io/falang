  "scripts": {
    "start": "TSX_TSCONFIG_PATH=../../../tsconfig.base.json tsx src/main.ts",
    "start:dev": "TSX_TSCONFIG_PATH=../../../tsconfig.base.json tsx watch src/main.ts",
    "test": "vitest run -c ../../../vitest.config.ts",
    "coverage": "vitest run --coverage -c ../../../vitest.config.ts",
    "check": "tsc --noEmit -p tsconfig.build.json",
    "typeorm": "NODE_OPTIONS='-r tsx/cjs' typeorm -d src/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
