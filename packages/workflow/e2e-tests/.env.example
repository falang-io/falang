# Copy to .env for local runs (`npm test`) against an already-running dev stack
# (docker-compose.workflow.yml or `npm run dev`/`npm run start:dev` on the host).
# docker-compose.workflow-e2e.yml overrides these with its own internal service addresses.

CLIENT_URL=http://localhost:5175
BACKEND_URL=http://localhost:4000
TEMPORAL_ADDRESS=localhost:7233
