{
  "name": "@falang/desktop-app-sketch",
  "private": true,
  "version": "1.0.0",
  "description": "Falang desktop IDE",
  "author": "",
  "homepage": "https://falang.io",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "check": "tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run -c ../../../vitest.config.ts",
    "coverage": "vitest run --coverage -c ../../../vitest.config.ts",
    "build:export-worker": "tsx build-export-worker.esbuild.ts",
    "prebuild:linux": "npm run build -w @falang/desktop-mcp && npm run build:export-worker",
    "build:linux": "electron-vite build && electron-builder --linux",
    "prebuild:mac": "npm run build -w @falang/desktop-mcp && npm run build:export-worker",
    "build:mac": "electron-vite build && electron-builder --mac",
    "prebuild:win": "npm run build -w @falang/desktop-mcp && npm run build:export-worker",
    "build:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.3",
    "@falang/agent": "*",
    "@falang/antd": "*",
    "@falang/desktop-llm-client": "*",
    "@falang/desktop-project-converter": "*",
    "@falang/desktop-project-fs": "*",
    "@falang/desktop-worker-process": "*",
    "@falang/di": "*",
    "@falang/dto": "*",
    "@falang/logic-dto": "*",
    "@falang/logic-export": "*",
    "@falang/logic-scheme": "*",
    "@falang/scheme": "*",
    "@falang/simple-code-dto": "*",
    "@falang/simple-code-export": "*",
    "@falang/simple-code-scheme": "*",
    "@falang/text-dto": "*",
    "@falang/text-scheme": "*",
    "@falang/typescript-agent": "*",
    "@falang/typescript-dto": "*",
    "@falang/typescript-scheme": "*",
    "@falang/versioning": "*",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "antd": "^6.3.7",
    "mobx": "^6.15.4",
    "mobx-react-lite": "^4.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.1.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.1",
    "vite": "^7.3.6"
  },
  "license": "AGPL-3.0-only",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.e2e.test.ts",
    "!src/**/*.workflow-e2e-spec.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.docker-e2e-spec.ts",
    "!src/**/*-test-harness.ts",
    "!src/test-utils",
    "!src/**/__snapshots__"
  ]
}
