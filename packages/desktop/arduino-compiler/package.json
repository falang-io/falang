{
  "name": "@falang/desktop-arduino-compiler",
  "version": "1.0.0",
  "description": "Electron-free Arduino sketch compiler: lowers pin/driver/built-in nodes and compiles setup/loop/functions to a .ino via @falang/logic-constructor (ADR 0020 / ADR 0051 (private))",
  "license": "AGPL-3.0-only",
  "author": "",
  "type": "commonjs",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run -c ../../../vitest.config.ts",
    "coverage": "vitest run --coverage -c ../../../vitest.config.ts",
    "check": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@falang/debug": "*",
    "@falang/desktop-arduino-cli": "*",
    "@falang/desktop-arduino-dto": "*",
    "@falang/dto": "*",
    "@falang/logic-constructor": "*",
    "@falang/typescript-dto": "*",
    "@types/node": "^25.5.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@falang/logic-e2e-tests": "*"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.e2e.test.ts",
    "!src/**/*.workflow-e2e-spec.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.docker-e2e-spec.ts",
    "!src/**/*-test-harness.ts",
    "!src/test-utils",
    "!src/**/__snapshots__"
  ]
}
