{
  "name": "@falang/desktop-arduino-dto",
  "version": "1.0.0",
  "description": "Electron/React-free Arduino node model (pin nodes, driver config/registry) shared by the desktop Arduino app and @falang/desktop-mcp (see ADR 0029 (private), phase E)",
  "license": "AGPL-3.0-only",
  "author": "",
  "type": "commonjs",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run -c ../../../vitest.config.ts",
    "coverage": "vitest run --coverage -c ../../../vitest.config.ts",
    "check": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@falang/dto": "*",
    "@types/node": "^25.5.0",
    "tslib": "^2.8.1",
    "zod": "^4.3.6"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.e2e.test.ts",
    "!src/**/*.workflow-e2e-spec.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.docker-e2e-spec.ts",
    "!src/**/*-test-harness.ts",
    "!src/test-utils",
    "!src/**/__snapshots__"
  ]
}
