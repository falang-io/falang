{
  "name": "@falang/desktop-mcp",
  "version": "1.0.0",
  "description": "A plain-Node stdio MCP server exposing a falang project folder (text or Arduino) to Claude Code and other MCP clients — see ADR 0029 (private), phase E",
  "license": "AGPL-3.0-only",
  "author": "",
  "type": "commonjs",
  "main": "src/index.ts",
  "bin": {
    "falang-mcp": "dist/index.js"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "tsx build.esbuild.ts",
    "test": "vitest run -c ../../../vitest.config.ts",
    "coverage": "vitest run --coverage -c ../../../vitest.config.ts",
    "check": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@falang/desktop-arduino-compiler": "*",
    "@falang/desktop-arduino-dto": "*",
    "@falang/desktop-project-fs": "*",
    "@falang/dto": "*",
    "@falang/mcp-core": "*",
    "@falang/typescript-dto": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^25.5.0",
    "tslib": "^2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "files": [
    "src",
    "dist",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.e2e.test.ts",
    "!src/**/*.workflow-e2e-spec.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.docker-e2e-spec.ts",
    "!src/**/*-test-harness.ts",
    "!src/test-utils",
    "!src/**/__snapshots__"
  ]
}
