{
  "name": "@falang/desktop-arduino-scheme",
  "version": "1.0.0",
  "description": "The Arduino IDE's scheme editor: arduinoSchemeFactory with the pin / built-in-function / driver-action node kinds and the driver registry cache (ADR 0023 / ADR 0051 (private))",
  "license": "AGPL-3.0-only",
  "author": "",
  "type": "commonjs",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run -c ../../../vitest.config.ts",
    "check": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@falang/desktop-arduino-dto": "*",
    "@falang/di": "*",
    "@falang/dto": "*",
    "@falang/scheme": "*",
    "@falang/typescript-scheme": "*",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "mobx": "^6.15.4",
    "mobx-react-lite": "^4.1.1",
    "react": "^19.2.4",
    "tslib": "^2.8.1"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.e2e.test.ts",
    "!src/**/*.workflow-e2e-spec.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.docker-e2e-spec.ts",
    "!src/**/*-test-harness.ts",
    "!src/test-utils",
    "!src/**/__snapshots__"
  ]
}
