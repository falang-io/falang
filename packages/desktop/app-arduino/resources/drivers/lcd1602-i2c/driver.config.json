{
  "id": "lcd1602-i2c",
  "label": "LCD1602 (I2C)",
  "version": "1.0.0",
  "includes": ["lcd1602-i2c-driver.h"],
  "sourceFiles": ["lcd1602-i2c-driver.h", "lcd1602-i2c-driver.cpp"],
  "declarations": [
    "declare function lcd_clear(): void;",
    "declare function lcd_print_text(col: number, row: number, text: string): void;",
    "declare function lcd_init(address: number): void;"
  ],
  "actions": [
    {
      "id": "clear",
      "label": "Clear display",
      "fields": [],
      "codeTemplate": "lcd_clear()"
    },
    {
      "id": "print-text",
      "label": "Print text",
      "fields": [
        { "name": "col", "label": "Column (0-15)", "kind": "number", "default": "0", "min": 0, "max": 15 },
        {
          "name": "row",
          "label": "Row",
          "kind": "select",
          "default": "0",
          "options": [
            { "value": "0", "label": "Row 1" },
            { "value": "1", "label": "Row 2" }
          ]
        },
        { "name": "text", "label": "Text", "kind": "string", "default": "Hello!" }
      ],
      "codeTemplate": "lcd_print_text(${col}, ${row}, ${text})"
    }
  ],
  "device": {
    "fields": [
      {
        "name": "address",
        "label": "I2C address",
        "kind": "select",
        "default": "39",
        "options": [
          { "value": "39", "label": "0x27" },
          { "value": "62", "label": "0x3E" },
          { "value": "32", "label": "0x20" }
        ]
      }
    ],
    "setupTemplate": "lcd_init(${address})"
  }
}
