{
  "name": "@falang/code-projection",
  "version": "1.0.0",
  "description": "Code projection: a bidirectional mapping between a function document's node tree and a readable TypeScript file, with id/meta-preserving writes (spike, see ADR 0061 (private))",
  "license": "AGPL-3.0-only",
  "author": "",
  "type": "commonjs",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run -c ../../../vitest.config.ts",
    "coverage": "vitest run --coverage -c ../../../vitest.config.ts",
    "check": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@falang/dto": "*",
    "@falang/typescript-dto": "*",
    "nanoid": "^3.3.11",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.e2e.test.ts",
    "!src/**/*.workflow-e2e-spec.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.docker-e2e-spec.ts",
    "!src/**/*-test-harness.ts",
    "!src/test-utils",
    "!src/**/__snapshots__"
  ]
}
