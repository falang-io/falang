{
  "name": "@falang/mcp-core",
  "version": "1.0.0",
  "description": "Transport-free MCP tool definitions, per-project-type NodesStack registry and validation/locking helpers shared by every MCP host (see ADR 0029 (private))",
  "license": "AGPL-3.0-only",
  "author": "",
  "type": "commonjs",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run -c ../../../vitest.config.ts",
    "coverage": "vitest run --coverage -c ../../../vitest.config.ts",
    "check": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@falang/dto": "*",
    "@falang/simple-code-dto": "*",
    "@falang/text-dto": "*",
    "@falang/typescript-dto": "*",
    "@falang/workflow-dto": "*",
    "tslib": "^2.8.1",
    "zod": "^4.3.6"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.e2e.test.ts",
    "!src/**/*.workflow-e2e-spec.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.docker-e2e-spec.ts",
    "!src/**/*-test-harness.ts",
    "!src/test-utils",
    "!src/**/__snapshots__"
  ]
}
