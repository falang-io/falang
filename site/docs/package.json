{
  "name": "falang-docs-site",
  "version": "1.0.0",
  "description": "Falang documentation site (Starlight) — two locale builds deployed to docs.falang.io / docs.falang.ru, see README.md",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:en": "SITE_LOCALE=en astro dev",
    "dev:ru": "SITE_LOCALE=ru astro dev --port 4322",
    "build:en": "SITE_LOCALE=en astro build --outDir dist/en",
    "build:ru": "SITE_LOCALE=ru astro build --outDir dist/ru",
    "build": "npm run build:en && npm run build:ru",
    "publish:ru": "npm run build:ru && scp -r dist/ru/. falang-ru:/projects/falang-docs/",
    "preview:en": "SITE_LOCALE=en astro preview --outDir dist/en",
    "preview:ru": "SITE_LOCALE=ru astro preview --outDir dist/ru",
    "check": "SITE_LOCALE=en astro check"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/starlight": "^0.42.1",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
